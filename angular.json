{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "fardelins-app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "{maplibre-gl-worker.mjs,maplibre-gl-shared.mjs,maplibre-gl.css}",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/maplibre/"
              },
              {
                "glob": "{ort-wasm-simd-threaded.mjs,ort-wasm-simd-threaded.wasm,ort-wasm-simd-threaded.jsep.mjs,ort-wasm-simd-threaded.jsep.wasm}",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "/ort/"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/pdfjs/"
              },
              {
                "glob": "worker-entry-C9UNuyOJ.js",
                "input": "node_modules/@paddleocr/paddleocr-js/dist/assets",
                "output": "/paddleocr/"
              }
            ],
            "styles": ["src/styles.css"],
            "fileReplacements": [
              {
                "replace": "node_modules/@techstark/opencv-js/dist/opencv.js",
                "with": "src/app/shims/opencv-worker-only.ts"
              }
            ],
            "serviceWorker": "ngsw-config.json",
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fardelins-app:build:production"
            },
            "development": {
              "buildTarget": "fardelins-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/test-setup.ts"],
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  }
}
